# Copy to ~/.config/pot/env (or .env beside the source while developing). Never commit the copy.

# OpenAI, for the realtime voice model and the research skill
OPENAI_API_KEY=

# Tuya IoT cloud project (iot.tuya.com -> Cloud -> your project -> Overview)
# Needed once to fetch each device's local key; also used as the cloud fallback.
TUYA_API_KEY=
TUYA_API_SECRET=
# The data centre the project was created in: in, eu, us or cn
TUYA_API_REGION=in

# Only when [service] points Pot at a relay that holds the OpenAI key instead of you
# POT_SERVICE_TOKEN=
